# Form backend endpoint. Empty = placeholder mode (no mail is sent, success is simulated).
# Examples: https://api.web3forms.com/submit  |  https://formspree.io/f/xxxx  |  your own POST endpoint
VITE_CONTACT_ENDPOINT=
# Optional access key some providers need (sent as field "access_key").
VITE_CONTACT_KEY=
# Base path for the build (GitHub Pages project site = /<repo>/ ; custom domain = /)
VITE_BASE=/soft-landing/
